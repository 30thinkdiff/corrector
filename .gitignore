!/scripts/
!/studies/
!/provenance/
!/third_party/
!/dev/
/runtime/*
!/runtime/*.py
!/runtime/*.sh
!/runtime/*manifest.json
!/runtime/environment.json
!/runtime/simulation.json
!/runtime/*constraints.txt
# object10中仅首提交明确加入的四个冻结JSON受版本管理，其余忽略。
/object10*/
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/venv/
**/sim-venv/
**/site-packages/
**/.git/
**/.vscode/
**/.codex/
**/.ssh/
**/.env
**/.env.*
*.pt
*.pth
*.safetensors
*.npy
*.npz
*.parquet
*.arrow
*.mp4
*.zip
*.bundle
*.log
